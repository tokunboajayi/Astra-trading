# Normalise line endings so generated files do not show as modified with an empty diff.
* text=auto eol=lf

# Fixtures are generated by scripts/build_fixtures.py, which writes LF. Without this they
# appear dirty on Windows checkouts even when their content is byte-identical.
fixtures/*.json text eol=lf
web/*.json      text eol=lf
web/scenes/*.json text eol=lf

*.png binary
